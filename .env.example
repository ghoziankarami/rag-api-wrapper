# RAG API Wrapper Configuration
# Copy this file to .env and update values

# API Key for Vercel RAG Dashboard to authenticate
# Generate a secure random string
RAG_API_KEY=your-secret-api-key-here

# Server Port (default: 3004)
PORT=3004

# Native Z.ai configuration for LLM-backed answers
ZAI_API_KEY=your-native-zai-api-key-here
ZAI_URL=https://api.z.ai/api/coding/paas/v4/chat/completions

# Public RAG answer model
# Current default: native Z.ai glm-4.7-flash
ZAI_MODEL=glm-4.7-flash


# Set paths for your own installation. Corpus collections must already exist.
# RAG_WORKSPACE=/absolute/path/to/workspace
# RAG_PAPERS_DB=/absolute/path/to/chroma/papers
# RAG_OBSIDIAN_PAPERS_DIR=/absolute/path/to/paper-notes
# RAG_ACTIVE_PDF_ROOT=/absolute/path/to/pdfs
# RAG_TRACKER_PATH=/absolute/path/to/papers.json
# RAG_PARITY_STATE=/absolute/path/to/paper_count_parity.json
RAG_STATS_TTL_MS=60000
